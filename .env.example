# .env.local 파일 생성하고 환경 변수 추가

# API 서버 주소
EXPO_PUBLIC_API_BASE_URL=

# 네이버 클라우드 플랫폼 > Maps > Application에서 발급
# https://console.ncloud.com/naver-service/application
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급한 OAuth 클라이언트 ID
# 웹 애플리케이션 유형 (앱도 이 ID로 ID 토큰을 받는다. 비우면 구글 로그인 버튼이 숨겨진다)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS 유형 (iOS 앱 구글 로그인용)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
